# Mercado Livre
ML_AFFILIATE_ID=
ML_AFFILIATE_TAG=
ML_COOKIE=
ML_CSRF_TOKEN=

# Amazon
AMAZON_ASSOCIATE_TAG=desconto.bot-20
AMAZON_AFFILIATE_TAG=desconto.bot-20
PUBLIC_SITE_BASE_URL=https://descontos-bot.vercel.app
OFFERS_EXPORT_PATH=data/exports/offers.json
OFFERS_JSON_OUTPUT_PATH=site/offers.json
PUBLISH_OFFERS_AFTER_CAPTURE=true
PUBLISH_OFFERS_PUSH=true
PUBLISH_OFFERS_BRANCH=main
SITE_OFFER_MAX_AGE_HOURS=36
ALLOW_PRODUCTION_WHATSAPP_SEND=false
SITE_PUBLIC_DIR=site
SITE_REPO_LOCAL_PATH=.
SITE_REPO_BRANCH=main

# Instagram
IG_USERNAME=
IG_PASSWORD=

# Painel admin
PANEL_USER=operador
PANEL_PASSWORD=

# Proxy residencial opcional (NUNCA datacenter)
HTTP_PROXY=
HTTPS_PROXY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID_HOMOLOG=@descontosbothmg
TELEGRAM_CHANNEL_ID_MAIN=@descontosbotlgm
TELEGRAM_RATE_LIMIT_SECONDS=1.1
TELEGRAM_DISCLOSURE_MESSAGE=Como Associado da Amazon, ganho por compras qualificadas.
ALLOW_PRODUCTION_TELEGRAM_SEND=false

# Handoff manual de stories do Instagram via DM Telegram
# Bot dedicado (criado no @BotFather), separado do TELEGRAM_BOT_TOKEN.
# Sem token ou chat_id, o handoff é desativado silenciosamente.
INSTAGRAM_HANDOFF_BOT_TOKEN=
INSTAGRAM_HANDOFF_CHAT_ID=
INSTAGRAM_HANDOFF_QUIET_HOURS_BRT=22:00-08:00
INSTAGRAM_TIMEZONE=America/Sao_Paulo
