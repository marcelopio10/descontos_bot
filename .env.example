# Django — segurança (Sprint 2 - Tarefa 2.4)
# SECRET_KEY é obrigatória quando DEBUG=False (produção): sem ela, o app recusa subir.
# Gere uma chave nova com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# NUNCA reutilize a chave de outro ambiente nem commit o valor real.
SECRET_KEY=
# False em produção. True só em desenvolvimento local.
DEBUG=False
# Hosts que este processo Django está autorizado a responder (Host header).
# Esta app não serve HTTP externo em produção hoje (roda apenas manage.py run_bot
# e comandos de management via systemd); admin/ é acessado só localmente.
# Lista separada por vírgula.
ALLOWED_HOSTS=localhost,127.0.0.1

# Mercado Livre
ML_AFFILIATE_ID=
ML_AFFILIATE_TAG=
ML_COOKIE=
ML_CSRF_TOKEN=

# Amazon
AMAZON_ASSOCIATE_TAG=desconto.bot-20
AMAZON_AFFILIATE_TAG=desconto.bot-20
PUBLIC_SITE_BASE_URL=https://descontos-bot.vercel.app
OFFERS_EXPORT_PATH=data/exports/offers.json
OFFERS_JSON_OUTPUT_PATH=site/offers.json
PUBLISH_OFFERS_AFTER_CAPTURE=true
PUBLISH_OFFERS_PUSH=true
PUBLISH_OFFERS_BRANCH=main
SITE_OFFER_MAX_AGE_HOURS=36
ALLOW_PRODUCTION_WHATSAPP_SEND=false

# WhatsApp provider: baileys mantém wa_service; evolution usa evolution_adapter.
WA_PROVIDER=baileys
WA_SERVICE_URL=http://127.0.0.1:8787
EVOLUTION_ADAPTER_URL=http://127.0.0.1:8788
EVOLUTION_ADAPTER_HOST=127.0.0.1
EVOLUTION_ADAPTER_PORT=8788
EVOLUTION_BASE_URL=http://localhost:8081
EVOLUTION_API_KEY=
EVOLUTION_INSTANCIA_ENVIO=descontos_envio
EVOLUTION_INSTANCIA_OBSERVER=descontos_observer
EVOLUTION_GROUP_MAP_PATH=evolution_adapter/config/group_map.json

SITE_PUBLIC_DIR=site
SITE_REPO_LOCAL_PATH=.
SITE_REPO_BRANCH=main

# Instagram
IG_USERNAME=
IG_PASSWORD=

# Painel admin
PANEL_USER=operador
PANEL_PASSWORD=

# Proxy residencial opcional (NUNCA datacenter)
HTTP_PROXY=
HTTPS_PROXY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID_HOMOLOG=@descontosbothmg
TELEGRAM_CHANNEL_ID_MAIN=@descontosbotlgm
TELEGRAM_RATE_LIMIT_SECONDS=1.1
TELEGRAM_DISCLOSURE_MESSAGE=Como Associado da Amazon, ganho por compras qualificadas.
ALLOW_PRODUCTION_TELEGRAM_SEND=false

# Handoff manual de stories do Instagram via DM Telegram
# Bot dedicado (criado no @BotFather), separado do TELEGRAM_BOT_TOKEN.
# Sem token ou chat_id, o handoff é desativado silenciosamente.
INSTAGRAM_HANDOFF_BOT_TOKEN=
INSTAGRAM_HANDOFF_CHAT_ID=
INSTAGRAM_HANDOFF_QUIET_HOURS_BRT=22:00-08:00
INSTAGRAM_TIMEZONE=America/Sao_Paulo

# Sprint 7A — Login do site privado (Vercel)
SITE_AUTH_USER=***
SITE_AUTH_PASSWORD_HASH=***=

# Sprint 7B — Shopee Affiliate Open API
# Conector oficial GraphQL. Travado por padrão: com SHOPEE_AFFILIATE_ENABLED=false,
# comandos reais abortam (exceto --dry-run/testes). Segredos só aqui, nunca no Git.
SHOPEE_AFFILIATE_API_URL=https://open-api.affiliate.shopee.com.br/graphql
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=
SHOPEE_AFFILIATE_DEFAULT_LIMIT=50
SHOPEE_AFFILIATE_TIMEOUT_SECONDS=20
SHOPEE_AFFILIATE_MAX_RETRIES=3
SHOPEE_AFFILIATE_ENABLED=false

# Sprint 6A — Market Intelligence WhatsApp
# Observer seguro: desligado por padrão, somente grupos explicitamente allowlisted.
WA_OBSERVER_ENABLED=false
WA_OBSERVER_GROUP_JIDS=
WA_OBSERVER_LOOKBACK_HOURS=24
WA_OBSERVER_MAX_MESSAGES_PER_GROUP=300
WA_OBSERVER_SENDER_HASH_SALT=

# Curadoria IA — Sprint 5
# Comandos atuais usam runner mockado/fake e não enviam mensagens reais.
AI_CURATION_AUDIT_DIR=runtime/curation/ai_runs
AI_CURATION_PUBLIC_DIR=runtime/curation/public
AI_CURATION_DEFAULT_CHANNEL=whatsapp_main
AI_CURATION_DEFAULT_MODE=dry_run
