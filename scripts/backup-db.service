[Unit]
Description=descontos.bot - Backup diário do SQLite (local + OneDrive comprimido)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/marce/apps/descontos_bot
ExecStart=/home/marce/apps/descontos_bot/scripts/backup_db.sh
StandardOutput=append:/home/marce/apps/descontos_bot/logs/backup-db.log
StandardError=append:/home/marce/apps/descontos_bot/logs/backup-db.log
