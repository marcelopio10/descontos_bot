[Unit]
Description=descontos.bot - Healthcheck do observer de WhatsApp e dos canais de distribuição
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/mnt/c/Users/marce/Documents/Projetos/descontos.bot
EnvironmentFile=/mnt/c/Users/marce/Documents/Projetos/descontos.bot/.env
ExecStart=/mnt/c/Users/marce/Documents/Projetos/descontos.bot/.venv/bin/python3 manage.py check_observer_health --hours 24
StandardOutput=append:/mnt/c/Users/marce/Documents/Projetos/descontos.bot/logs/check-observer-health.log
StandardError=append:/mnt/c/Users/marce/Documents/Projetos/descontos.bot/logs/check-observer-health.log
