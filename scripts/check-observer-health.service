[Unit]
Description=descontos.bot - Healthcheck do observer de WhatsApp e dos canais de distribuição
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/marce/apps/descontos_bot
EnvironmentFile=/home/marce/apps/descontos_bot/.env
ExecStart=/home/marce/apps/descontos_bot/.venv/bin/python3 manage.py check_observer_health --hours 24 --delivery-hours 6 --channel whatsapp_principal --active-delivery-hours
StandardOutput=append:/home/marce/apps/descontos_bot/logs/check-observer-health.log
StandardError=append:/home/marce/apps/descontos_bot/logs/check-observer-health.log
