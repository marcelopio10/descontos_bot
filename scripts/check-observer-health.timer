[Unit]
Description=descontos.bot - Disparo periódico do healthcheck do observer/canais

[Timer]
# Supervisão independente do coletor e do scheduler. O calendário persistente
# recupera uma execução perdida após desligamento. Fora do silêncio noturno,
# checa a cada hora, com tempo para a retomada normal do primeiro ciclo.
OnCalendar=*-*-* 09..23:00:00 America/Sao_Paulo
Persistent=true
Unit=check-observer-health.service

[Install]
WantedBy=timers.target
