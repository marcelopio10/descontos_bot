[Unit]
Description=descontos.bot - Pipeline diário de cupons
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/marce/apps/descontos_bot
EnvironmentFile=/home/marce/apps/descontos_bot/.env
Environment=PATH=/home/marce/.local/bin:/usr/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/marce/apps/descontos_bot/.venv/bin/python3 manage.py run_coupon_pipeline --once --runner real
StandardOutput=append:/home/marce/apps/descontos_bot/logs/coupons-daily.log
StandardError=append:/home/marce/apps/descontos_bot/logs/coupons-daily.log
