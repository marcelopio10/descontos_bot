[Unit]
Description=descontos.bot - Evolution adapter (bridge WhatsApp entre run_bot e Evolution API)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/marce/apps/descontos_bot/evolution_adapter
# O adapter carrega /home/marce/apps/descontos_bot/.env sozinho (src/env.js), então não precisa de
# EnvironmentFile. Ajuste o caminho do node conforme a instalação (aqui: nvm).
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=10
StandardOutput=append:/home/marce/apps/descontos_bot/logs/evolution_adapter.out
StandardError=append:/home/marce/apps/descontos_bot/logs/evolution_adapter.out

[Install]
WantedBy=default.target
