[Unit]
Description=descontos.bot - Sincroniza cliques do Vercel KV para o banco local
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/mnt/c/Users/marce/Documents/Projetos/descontos.bot
EnvironmentFile=/mnt/c/Users/marce/Documents/Projetos/descontos.bot/.env
ExecStart=/mnt/c/Users/marce/Documents/Projetos/descontos.bot/.venv/bin/python3 manage.py fetch_clicks --limit 500 --clear
StandardOutput=append:/mnt/c/Users/marce/Documents/Projetos/descontos.bot/logs/fetch-clicks.log
StandardError=append:/mnt/c/Users/marce/Documents/Projetos/descontos.bot/logs/fetch-clicks.log
