[Unit]
Description=descontos.bot - Sincroniza cliques do Vercel KV para o banco local
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/marce/apps/descontos_bot
EnvironmentFile=/home/marce/apps/descontos_bot/.env
ExecStart=/home/marce/apps/descontos_bot/.venv/bin/python3 manage.py fetch_clicks --limit 500 --clear
StandardOutput=append:/home/marce/apps/descontos_bot/logs/fetch-clicks.log
StandardError=append:/home/marce/apps/descontos_bot/logs/fetch-clicks.log
