[Unit]
Description=descontos.bot - Disparo semanal do lembrete de contagem de membros

[Timer]
# Segunda 09:00: o dono conta o grupo e registra. Depois do relatório das 07:10,
# de propósito — o lembrete chega junto do resumo que dá contexto ao número.
OnCalendar=Mon *-*-* 09:00:00
Persistent=true
Unit=lembrar-metrica-canal.service

[Install]
WantedBy=timers.target
