[Unit]
Description=descontos.bot - Coleta e publica o relatório diário de market intel (observer WhatsApp)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/marce/apps/descontos_bot
EnvironmentFile=/home/marce/apps/descontos_bot/.env
ExecStart=/bin/bash /home/marce/apps/descontos_bot/scripts/market_intel_daily.sh
StandardOutput=append:/home/marce/apps/descontos_bot/logs/market-intel.log
StandardError=append:/home/marce/apps/descontos_bot/logs/market-intel.log
