[Unit]
Description=descontos.bot - Publica ofertas curadas no canal Telegram principal
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/marce/apps/descontos_bot
EnvironmentFile=/home/marce/apps/descontos_bot/.env
# systemd --user usa um PATH mínimo que não inclui ~/.local/bin, onde o CLI
# `hermes` (curadoria IA, --runner real) está instalado. Sem isso, o prepare
# falha com "Hermes CLI indisponível: No such file or directory: 'hermes'".
Environment=PATH=/home/marce/.local/bin:/usr/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/marce/apps/descontos_bot/.venv/bin/python3 manage.py publish_telegram --once --channel telegram_main --confirm-ai-production CONFIRM_AI_PRODUCTION
StandardOutput=append:/home/marce/apps/descontos_bot/logs/publish-telegram.log
StandardError=append:/home/marce/apps/descontos_bot/logs/publish-telegram.log
