[Unit]
Description=descontos.bot - Radar de concorrente (ingestão do observer + resolução de links)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/marce/apps/descontos_bot
EnvironmentFile=/home/marce/apps/descontos_bot/.env
Environment=PATH=/home/marce/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/bin/bash /home/marce/apps/descontos_bot/scripts/radar_concorrente.sh
StandardOutput=append:/home/marce/apps/descontos_bot/logs/radar-concorrente.log
StandardError=append:/home/marce/apps/descontos_bot/logs/radar-concorrente.log
