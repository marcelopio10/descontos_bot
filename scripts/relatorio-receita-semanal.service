[Unit]
Description=descontos.bot - Relatório semanal publicado x vendido
# Depende da ingestão do painel do ML, que traz o lado da venda. Se aquela
# falhar, este relatório roda mesmo assim e reporta a janela com o dado antigo —
# é preferível a não rodar, porque a comparação por faixa de preço continua
# válida sobre o que já foi ingerido.
After=ingest-ml-afiliados.service

[Service]
Type=oneshot
WorkingDirectory=/mnt/c/Users/marce/Documents/Projetos/descontos.bot
# 8 semanas: janela larga o bastante para a comparação por faixa não virar ruído
# com 10 vendas, e curta o bastante para uma quebra aparecer.
ExecStart=/mnt/c/Users/marce/Documents/Projetos/descontos.bot/.venv/bin/python3 manage.py relatorio_receita_semanal --weeks 8 --alert
StandardOutput=append:/mnt/c/Users/marce/Documents/Projetos/descontos.bot/logs/relatorio-receita-semanal.log
StandardError=append:/mnt/c/Users/marce/Documents/Projetos/descontos.bot/logs/relatorio-receita-semanal.log
