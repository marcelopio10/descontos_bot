[Unit]
Description=descontos.bot - Scheduler local (scraping + curadoria + envio)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/mnt/c/Users/marce/Documents/Projetos/descontos.bot
EnvironmentFile=/mnt/c/Users/marce/Documents/Projetos/descontos.bot/.env
# systemd --user usa um PATH mínimo que não inclui ~/.local/bin (CLI `hermes`)
# nem o node do nvm.
Environment=PATH=/home/marce/.local/bin:/home/marce/.nvm/versions/node/v24.15.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# --channel whatsapp_principal é obrigatório: sem ele o comando cai no default
# `whatsapp_main`, que é HOMOLOGAÇÃO — e aí o guard de produção nem dispara,
# porque ele só exige confirmação em canal de produção.
#
# --ai-curation-required (decisão do dono, 2026-08-23, item 9 da Onda 1): quando
# a curadoria IA falha, o ciclo aborta em vez de cair no selector legado. Com 99
# membros no grupo, volume não é alavanca; o legado chegou a 30% dos envios numa
# semana e não tem uma venda casada. Reverter = tirar a flag e reiniciar.
ExecStart=/mnt/c/Users/marce/Documents/Projetos/descontos.bot/.venv/bin/python3 manage.py run_bot --channel whatsapp_principal --confirm-ai-production CONFIRM_AI_PRODUCTION --ai-curation-required
Restart=always
RestartSec=30
StandardOutput=append:/mnt/c/Users/marce/Documents/Projetos/descontos.bot/logs/run-bot.log
StandardError=append:/mnt/c/Users/marce/Documents/Projetos/descontos.bot/logs/run-bot.log

[Install]
WantedBy=default.target
