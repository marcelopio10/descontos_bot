{
  "name": "wa-service",
  "version": "1.0.0",
  "description": "WhatsApp posting service via Baileys (no browser)",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node --loader ts-node/esm src/server.ts",
    "dev": "node --loader ts-node/esm --experimental-specifier-resolution=node src/server.ts",
    "test": "vitest run"
  },
  "type": "module",
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.9",
    "express": "^4.18.2",
    "pino": "^8.19.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.0",
    "@types/qrcode-terminal": "^0.12.2",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
